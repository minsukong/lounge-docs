{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsconfig.preview.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "dist",
    "storybook-static",
    "coverage",
    "src/test",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
