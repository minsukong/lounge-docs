{
  "name": "lounge-webview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node ../scripts/package-runtime.mjs .",
    "start": "node dist/runtime/server.js",
    "typecheck": "next typegen && tsc --noEmit --project tsconfig.check.json",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build:preview": "node ../scripts/build-preview.mjs ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "lucide-react": "1.55.0",
    "next": "16.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "zod": "4.6.6",
    "@lounge/ui": "0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
