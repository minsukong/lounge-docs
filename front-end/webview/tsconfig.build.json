{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "tsBuildInfoFile": ".next/cache/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules", ".next/dev", "dist", "storybook-static", "coverage",
    "src/dev", "src/test", "src/app/preview",
    "**/*.stories.ts", "**/*.stories.tsx", "**/*.test.ts", "**/*.test.tsx"
  ]
}
